{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": false
  },
  "organizeImports": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      ".venv",
      "**/package-lock.json",
      ".claude/settings.local.json",
      "apps/premiere/adobe-mcp/uxp-plugins/premiere/socket.io.js",
      "apps/premiere/adobe-mcp/uxp-plugins/premiere/main.js",
      "apps/premiere/scripts/legacy-extendscript"
    ]
  }
}
